---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import weather from "../assets/weather.json";
import olympians from "../assets/olympians.json";
---

<Layout>
    <header class="mb-8">
      <p class="p-4 mb-3 text-xl font-bold uppercase text-cyan-700">Data visualisation</p>
  
    </header>
<ul class="flex flex-wrap gap-2">
  <li class="p-2 m-2 bg-cyan-800 text-white rounded-3xl"><a href="/penguins">Penguins</a></li>
  <li class="p-2 m-2 bg-cyan-800 text-white rounded-3xl"><a href="/pizza">Pizza</a></li>
  <li class="p-2 m-2 bg-cyan-800 text-white rounded-3xl"><a href="/">Météo</a></li>
    </ul>
  
    <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-xl">
      <div>
        <PlotFigure
          options={{
			title:"Météo",
			caption:"Le graphique montre la température minimum (en ordonnées) et la température maximum (en absisses)",
            marks: [
              Plot.dot(weather,{
                x: "temp_max",
                y: "temp_min",
              })
            ]
          }}
        />
      </div>
    </section>
    <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-xl">
      <div>
        <PlotFigure
          options={{
			title:"Olympians",
			caption:"Le graphique représente la taille par la hauteur des athlète olympique",
            marks: [
              Plot.dot(olympians,{
                x: "weight",
                y: "height",
              })
            ]
          }}
        />
      </div>
    </section>
</Layout>


<script>
   const menuItems = document.querySelectorAll(".menu-item");
   const items = document.querySelectorAll(".item");
   
   console.log("menuItems", menuItems);
   console.log("items", items);
   const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.getAttribute("id");
          const menuItem = document.querySelector(`.menu-item[href="#${id}"]`);
          if (entry.isIntersecting) {
            menuItem?.classList.add("active");
          } else {
            menuItem?.classList.remove("active");
          }
        });
      },
      { threshold: 0.5 },
    );

    items.forEach((item) => {
      observer.observe(item);
    });
</script>