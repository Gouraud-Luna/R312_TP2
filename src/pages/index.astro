---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
import pizza from "../assets/pizza.json";
import weather from "../assets/weather.json";
import olympians from "../assets/olympians.json";
---

<Layout>
    <header class="mb-8">
      <p class="p-4 mb-3 text-xl font-bold uppercase text-cyan-700">Data visualisation</p>
  
    </header>

    <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-xl">    
    <ul>
      <li><a href="#gentoo">Gentoo</a></li>
      <li><a href="#adelie">Adelie</a></li>
      <li><a href="#chinstrap">Chinstrap</a></li>
    </ul>
  <div id="gentoo">
    <PlotFigure
      options={{
        marks: [
          Plot.dot(penguins, {
            filter: (d) => d.species === "Gentoo",
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
  </div>
  <div id="adelie">
    <PlotFigure
      options={{
        marks: [
          Plot.dot(penguins, {
            filter: (d) => d.species === "Adelie",
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
  </div>
  <div id="chinstrap">
    <PlotFigure
      options={{
        marks: [
          Plot.dot(penguins, {
            filter: (d) => d.species === "Chinstrap",
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
  </div>
      <div>
        <PlotFigure
          options={{
			title:"Pizza",
			caption:"Le graphique représente les commandes par prix",
            marks: [
              Plot.dot(pizza, {
                x: "price",
                y: "orders",
              })
            ]
          }}
        />
      </div>
      <div>
        <PlotFigure
          options={{
			title:"Météo",
			caption:"Le graphique montre la température minimum (en ordonnées) et la température maximum (en absisses)",
            marks: [
              Plot.dot(weather,{
                x: "temp_max",
                y: "temp_min",
              })
            ]
          }}
        />
      </div>
      <div>
        <PlotFigure
          options={{
			title:"Olympians",
			caption:"Le graphique représente la taille par la hauteur des athlète olympique",
            marks: [
              Plot.dot(olympians,{
                x: "weight",
                y: "height",
              })
            ]
          }}
        />
      </div>
    </section>
</Layout>
